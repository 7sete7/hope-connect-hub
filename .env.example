# Copie para .env e preencha.

# Chave para assinar os tokens de login. Gere com: openssl rand -hex 32
JWT_SECRET=

# Admin criado no primeiro start (banco vazio). Depois disso, alterar aqui não muda a senha.
ADMIN_EMAIL=admin@entreellasoficial.com.br
ADMIN_PASSWORD=

# Deploy (deploy.sh) — servidor compartilhado com o sidekick
DEPLOY_HOST=
DEPLOY_USER=rocky
DEPLOY_PATH=~/entreellas

# Rede Docker do Caddy compartilhado (docker-compose.prod.yml)
# PROXY_NETWORK=sidekick_default
